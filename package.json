{
  "name": "paymux-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web-dashboard/vite.config.ts",
    "dev:home": "vite --config web-home/vite.config.ts",
    "build": "bun run build:dashboard && bun run build:home",
    "build:dashboard": "vite build --config web-dashboard/vite.config.ts",
    "build:home": "vite build --config web-home/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:frontend": "bun test frontend web-dashboard/src",
    "test:home": "playwright test --config playwright.home.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.3"
}
