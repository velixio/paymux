{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["components", "lib", "dashboard", "home/src", "home/vite.config.ts"],
  "exclude": ["**/*.test.ts", "dashboard/e2e"]
}
