# Copy to .env for local development. Dev-safe values only.
PAYMUX_ENV=development
PAYMUX_BASE_URL=http://localhost:8080
PAYMUX_LISTEN=:8080
PAYMUX_INTERNAL_LISTEN=127.0.0.1:9100
PAYMUX_DATA_DIR=./data
# Defaults to sqlite://<PAYMUX_DATA_DIR>/paymux.db; also sqlite:///abs/path.db or postgres://...
# PAYMUX_DATABASE_URL=sqlite://./data/paymux.db
# Exactly one of PAYMUX_MASTER_KEY / PAYMUX_MASTER_KEY_FILE is required.
# Generate a key with: head -c32 /dev/urandom | base64
PAYMUX_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# PAYMUX_MASTER_KEY_FILE=./data/master.key
PAYMUX_TZ=Asia/Kolkata
PAYMUX_DEV_SKIP_2FA=true
# PAYMUX_ENV_FILE=.env
# Tests only:
# PAYMUX_TEST_POSTGRES_URL=
# PAYMUX_REQUIRE_PG=
