{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paymux.example/schemas/einvoice-1.1.json",
  "title": "GST e-invoice, INV-01, version 1.1 (IRP offline upload)",
  "$comment": "Written from the published INV-01 field list (NIC IRP, schema version 1.1). Every constraint below was transcribed by hand and has NOT been checked against the portal's own schema file: TODO(spec) fetch the official JSON schema and diff it with this one. Keywords starting with x- are Paymux's own: x-maxDecimals limits the digits after the decimal point.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Version",
    "TranDtls",
    "DocDtls",
    "SellerDtls",
    "BuyerDtls",
    "ItemList",
    "ValDtls"
  ],
  "properties": {
    "Version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "Irn": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "$comment": "TODO(spec): the IRP returns the IRN; an upload normally omits it"
    },
    "TranDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TaxSch",
        "SupTyp"
      ],
      "properties": {
        "TaxSch": {
          "type": "string",
          "enum": [
            "GST"
          ]
        },
        "SupTyp": {
          "type": "string",
          "enum": [
            "B2B",
            "SEZWP",
            "SEZWOP",
            "EXPWP",
            "EXPWOP",
            "DEXP"
          ]
        },
        "RegRev": {
          "type": "string",
          "enum": [
            "Y",
            "N"
          ]
        },
        "EcmGstin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9]{2}[0-9A-Z]{13})$"
        },
        "IgstOnIntra": {
          "type": "string",
          "enum": [
            "Y",
            "N"
          ]
        }
      }
    },
    "DocDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Typ",
        "No",
        "Dt"
      ],
      "properties": {
        "Typ": {
          "type": "string",
          "enum": [
            "INV",
            "CRN",
            "DBN"
          ]
        },
        "No": {
          "type": "string",
          "pattern": "^([A-Z1-9][A-Z0-9/-]{0,15})$",
          "$comment": "at most 16 characters (CGST Rule 46), no leading zero, no lower case"
        },
        "Dt": {
          "type": "string",
          "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/(20[0-9]{2})$",
          "$comment": "DD/MM/YYYY"
        }
      }
    },
    "SellerDtls": {
      "$ref": "#/definitions/seller"
    },
    "BuyerDtls": {
      "$ref": "#/definitions/buyer"
    },
    "ItemList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "SlNo",
          "IsServc",
          "HsnCd",
          "UnitPrice",
          "TotAmt",
          "AssAmt",
          "GstRt",
          "TotItemVal"
        ],
        "properties": {
          "SlNo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "PrdDesc": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "IsServc": {
            "type": "string",
            "enum": [
              "Y",
              "N"
            ]
          },
          "HsnCd": {
            "type": "string",
            "pattern": "^[0-9]{4,8}$",
            "$comment": "HSN for goods, SAC for services"
          },
          "Barcde": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "Qty": {
            "type": "number",
            "minimum": 0,
            "x-maxDecimals": 3
          },
          "FreeQty": {
            "type": "number",
            "minimum": 0,
            "x-maxDecimals": 3
          },
          "Unit": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "$comment": "TODO(spec): the portal restricts this to its UQC list (OTH, NOS, ...)"
          },
          "UnitPrice": {
            "type": "number",
            "minimum": 0,
            "x-maxDecimals": 3
          },
          "TotAmt": {
            "$ref": "#/definitions/amount"
          },
          "Discount": {
            "$ref": "#/definitions/amount"
          },
          "PreTaxVal": {
            "$ref": "#/definitions/amount"
          },
          "AssAmt": {
            "$ref": "#/definitions/amount"
          },
          "GstRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999,
            "x-maxDecimals": 3
          },
          "IgstAmt": {
            "$ref": "#/definitions/amount"
          },
          "CgstAmt": {
            "$ref": "#/definitions/amount"
          },
          "SgstAmt": {
            "$ref": "#/definitions/amount"
          },
          "CesRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999,
            "x-maxDecimals": 3
          },
          "CesAmt": {
            "$ref": "#/definitions/amount"
          },
          "CesNonAdvlAmt": {
            "$ref": "#/definitions/amount"
          },
          "StateCesRt": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999,
            "x-maxDecimals": 3
          },
          "StateCesAmt": {
            "$ref": "#/definitions/amount"
          },
          "StateCesNonAdvlAmt": {
            "$ref": "#/definitions/amount"
          },
          "OthChrg": {
            "$ref": "#/definitions/amount"
          },
          "TotItemVal": {
            "$ref": "#/definitions/amount"
          }
        }
      }
    },
    "ValDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AssVal",
        "TotInvVal"
      ],
      "properties": {
        "AssVal": {
          "$ref": "#/definitions/amount"
        },
        "CgstVal": {
          "$ref": "#/definitions/amount"
        },
        "SgstVal": {
          "$ref": "#/definitions/amount"
        },
        "IgstVal": {
          "$ref": "#/definitions/amount"
        },
        "CesVal": {
          "$ref": "#/definitions/amount"
        },
        "StCesVal": {
          "$ref": "#/definitions/amount"
        },
        "Discount": {
          "$ref": "#/definitions/amount"
        },
        "OthChrg": {
          "$ref": "#/definitions/amount"
        },
        "RndOffAmt": {
          "type": "number",
          "minimum": -99.99,
          "maximum": 99.99,
          "x-maxDecimals": 2
        },
        "TotInvVal": {
          "$ref": "#/definitions/amount"
        },
        "TotInvValFc": {
          "$ref": "#/definitions/amount"
        }
      }
    },
    "ExpDtls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ShipBNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "ShipBDt": {
          "type": "string",
          "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/(20[0-9]{2})$"
        },
        "Port": {
          "type": "string",
          "pattern": "^[0-9A-Z]{2,10}$"
        },
        "RefClm": {
          "type": "string",
          "enum": [
            "Y",
            "N"
          ]
        },
        "ForCur": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "CntCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "ExpDuty": {
          "$ref": "#/definitions/amount"
        }
      }
    },
    "PayDtls": {
      "type": "object",
      "$comment": "TODO(spec): payment details are optional and not generated"
    },
    "RefDtls": {
      "type": "object",
      "$comment": "Only the preceding document of a credit note is generated (PrecDocDtls); the portal's other reference fields (InvRm, DocPerdDtls, ContrDtls, ...) are optional and not generated.",
      "properties": {
        "PrecDocDtls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "InvNo",
              "InvDt"
            ],
            "properties": {
              "InvNo": {
                "type": "string",
                "pattern": "^([A-Z1-9][A-Z0-9/-]{0,15})$"
              },
              "InvDt": {
                "type": "string",
                "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$"
              }
            }
          }
        }
      }
    },
    "AddlDocDtls": {
      "type": "array",
      "$comment": "TODO(spec): supporting documents are optional and not generated"
    },
    "EwbDtls": {
      "type": "object",
      "$comment": "TODO(spec): e-way bill details do not apply to services"
    },
    "DispDtls": {
      "type": "object",
      "$comment": "TODO(spec): dispatch details do not apply to services"
    },
    "ShipDtls": {
      "type": "object",
      "$comment": "TODO(spec): shipping details do not apply to services"
    }
  },
  "definitions": {
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000.0,
      "x-maxDecimals": 2
    },
    "seller": {
      "type": "object",
      "required": [
        "Gstin",
        "LglNm",
        "Addr1",
        "Loc",
        "Pin",
        "Stcd"
      ],
      "properties": {
        "Gstin": {
          "type": "string",
          "pattern": "^([0-9]{2}[0-9A-Z]{13})$"
        },
        "LglNm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "TrdNm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Addr1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Addr2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Loc": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50
        },
        "Pin": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "Stcd": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-3][0-9]|9[0-9])$"
        },
        "Ph": {
          "type": "string",
          "pattern": "^([0-9]{6,12})$"
        },
        "Em": {
          "type": "string",
          "minLength": 6,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "buyer": {
      "type": "object",
      "required": [
        "Gstin",
        "LglNm",
        "Pos",
        "Addr1",
        "Loc",
        "Pin",
        "Stcd"
      ],
      "properties": {
        "Gstin": {
          "type": "string",
          "pattern": "^(([0-9]{2}[0-9A-Z]{13})|URP)$",
          "$comment": "URP: an unregistered person, used for exports"
        },
        "LglNm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "TrdNm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Pos": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-3][0-9]|9[0-9])$",
          "$comment": "place of supply state code; 96 for a supply outside India"
        },
        "Addr1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Addr2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "Loc": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50
        },
        "Pin": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "Stcd": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-3][0-9]|9[0-9])$"
        },
        "Ph": {
          "type": "string",
          "pattern": "^([0-9]{6,12})$"
        },
        "Em": {
          "type": "string",
          "minLength": 6,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    }
  }
}
